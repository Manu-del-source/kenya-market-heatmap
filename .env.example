# ---------------------------------------------------------------------------
# Kenya Market Intelligence — environment variables
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# --- Market data provider ---------------------------------------------------
# auto (default) | demo | nse
#   auto → use the licensed NSE feed when fully configured, otherwise demo
#   demo → always use clearly-labelled sample data
#   nse  → require the licensed feed; fail loudly if it is not configured
MARKET_DATA_PROVIDER=auto

# Licensed NSE market data feed. Required when MARKET_DATA_PROVIDER=nse.
# See docs/market-data.md — NSE data is licensed, not open.
NSE_MARKET_API_BASE_URL=
NSE_MARKET_API_KEY=
# Vendor name used in attribution, e.g. "SIX Financial Information"
NSE_MARKET_API_VENDOR=
# live | delayed-15m | end-of-day
NSE_MARKET_API_FEED=delayed-15m
NSE_MARKET_API_TIMEOUT_MS=10000

# --- Database ---------------------------------------------------------------
# When unset the app uses the in-memory store (nothing persists across restarts).
# Set this to a Postgres connection string to persist ingested market history.
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=5

# --- Caching ---------------------------------------------------------------
MARKET_DATA_CACHE_TTL_SECONDS=60
MARKET_HISTORY_CACHE_TTL_SECONDS=900
MARKET_CACHE_MAX_ENTRIES=500
# Force every response to be uncached (useful when demoing live changes)
MARKET_DATA_DISABLE_CACHE=false

# --- API -------------------------------------------------------------------
API_RATE_LIMIT_PER_MINUTE=120
API_MAX_PAGE_SIZE=100
API_DEFAULT_PAGE_SIZE=25

# --- Scheduled ingestion ---------------------------------------------------
# Shared secret for POST /api/cron/ingest. Required for the cron endpoint to
# run; generate with: openssl rand -hex 32
CRON_SECRET=

# --- Site / SEO ------------------------------------------------------------
# Absolute origin used for canonical URLs, Open Graph tags and sitemap.xml
NEXT_PUBLIC_SITE_URL=http://localhost:3000
